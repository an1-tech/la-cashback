# Sao chép thành .env. Chỉ cho phép DEMO_MODE=true ở phiên bản này.
HOST=127.0.0.1
PORT=3080
DATABASE_PATH=./data/cashback.sqlite
DEMO_MODE=true
# Chỉ bật sau reverse proxy HTTPS, không dùng cho HTTP localhost.
COOKIE_SECURE=false
# Online demo: bật cả PUBLIC_DEMO và COOKIE_SECURE sau proxy HTTPS.
PUBLIC_DEMO=false
# Chỉ dùng khi PUBLIC_DEMO=true. Đặt secret riêng dài ít nhất 16 ký tự.
# DEMO_ADMIN_PASSWORD=

# Tùy chọn lưu demo miễn phí trên Turso (chỉ ở backend, không dùng tiền tố VITE_).
# Đặt cả hai để dùng Turso; bỏ cả hai để dùng SQLite local.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Dữ liệu tham khảo phi thương mại cho demo đề án (chỉ ở backend).
# Tạo key tại addlivetag.com → API Key. Không dùng tiền tố VITE_.
# ADDLIVETAG_API_KEY=
# Chỉ đặt tier đã xác minh của tài khoản bạn; bỏ trống = tỷ lệ tài khoản proxy.
# ADDLIVETAG_BASE_RATE=8
# ADDLIVETAG_CAP=20000
